#!/bin/bash

# ==============================================================================
# 万能二维材料 MD 稳定性评估脚本 (【能量主导】物理优化版)
# 核心逻辑: 彻底解除“最大原子位移”的否决权，以 md.dat 热力学演化为绝对判定核心。
# ==============================================================================

# ==============================================================================
# 🎯 阈值设置 (最大位移仅作展示，不再参与生死判定)
# ==============================================================================
WARN_RMSD_XY=0.5      DANGER_RMSD_XY=0.8      # 面内整体拉伸形变警告阈值 (Å)
WARN_MAX_DISP=1.0     DANGER_MAX_DISP=1.5     # 面内最大原子位移 (仅作面板变色展示，不影响结论)
WARN_RMSD_Z=2.5       DANGER_RMSD_Z=4.0       # 面外波浪热起伏 (Å)

# [热力学主判据]
WARN_E_STD=0.04       DANGER_E_STD=0.08       # 单原子能量震荡阈值 (eV/atom)
DANGER_E_SPIKE=0.08                           # 能量不可逆暴涨阈值 (eV/atom)
# ==============================================================================

C_BLUE='\033[1;36m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_GREEN='\033[1;32m'; C_RESET='\033[0m'

format_color() {
    local val=$1; local warn=$2; local danger=$3
    local status=$(awk -v v="$val" -v w="$warn" -v d="$danger" 'BEGIN {
        if (v > d) print "RED"; else if (v > w) print "YELLOW"; else print "BLUE";
    }')
    if [ "$status" == "RED" ]; then echo -e "${C_RED}${val}${C_RESET}"
    elif [ "$status" == "YELLOW" ]; then echo -e "${C_YELLOW}${val}${C_RESET}"
    else echo -e "${C_BLUE}${val}${C_RESET}"
    fi
}

format_e_drift() {
    local val=$1; local danger=$2
    local status=$(awk -v v="$val" -v d="$danger" 'BEGIN {
        if (v > d) print "RED"; else if (v > 0.02) print "YELLOW"; else if (v < -0.01) print "GREEN"; else print "BLUE";
    }')
    if [ "$status" == "RED" ]; then echo -e "${C_RED}${val}${C_RESET}"
    elif [ "$status" == "YELLOW" ]; then echo -e "${C_YELLOW}${val}${C_RESET}"
    elif [ "$status" == "GREEN" ]; then echo -e "${C_GREEN}${val}${C_RESET}"
    else echo -e "${C_BLUE}${val}${C_RESET}"
    fi
}

# --- 文件自动获取 ---
if [ "$#" -eq 2 ]; then
    F1="$1"; F2="$2"
else
    if [ -f "POSCAR" ] && [ -f "CONTCAR" ]; then
        F1="POSCAR"; F2="CONTCAR"
    else
        shopt -s nullglob; STRUCT_FILES=(*.cif *.vasp *.xyz); shopt -u nullglob
        if [ "${#STRUCT_FILES[@]}" -eq 2 ]; then
            F1="${STRUCT_FILES[0]}"; F2="${STRUCT_FILES[1]}"
        else
            echo -e "${C_RED}错误: 未找到2个匹配的结构文件！请手动指定: ./check_md.sh a.cif b.cif${C_RESET}" && exit 1
        fi
    fi
fi

if [ ! -f "$F1" ] || [ ! -f "$F2" ]; then
    echo -e "${C_RED}错误: 选定的文件不存在！${C_RESET}" && exit 1
fi

THERMO_FILE=""
if [ -f "md.dat" ]; then THERMO_FILE="md.dat"
elif [ -f "Temperature.txt" ]; then THERMO_FILE="Temperature.txt"
fi

# --- Python 核心计算 ---
OUTPUT=$(python3 -c "
import sys, os, warnings
import numpy as np
from ase.io import read
warnings.filterwarnings('ignore')

try:
    atoms1 = read(sys.argv[1]); atoms2 = read(sys.argv[2]); thermo_file = sys.argv[3]
    n_atoms = len(atoms1)
    if n_atoms != len(atoms2): sys.exit('ERROR|原子数不一致')

    elems = list(set(atoms1.get_chemical_symbols()))
    sys_elems_str = '-'.join(sorted(elems))
    masses = atoms1.get_masses(); total_mass = np.sum(masses)
    pos1 = atoms1.get_positions(); pos2 = atoms2.get_positions(); cell = atoms1.get_cell()

    diff = pos2 - pos1
    if any(atoms1.get_pbc()) and atoms1.get_volume() > 1e-8:
        f_diff = np.dot(diff, np.linalg.inv(cell))
        f_diff[:, 0] -= np.round(f_diff[:, 0]); f_diff[:, 1] -= np.round(f_diff[:, 1])
        diff = np.dot(f_diff, cell)
    pos2_uw = pos1 + diff

    com1 = np.average(pos1, axis=0, weights=masses)
    com2 = np.average(pos2_uw, axis=0, weights=masses)
    drift = com2 - com1
    p1_c = pos1 - com1; p2_c = pos2_uw - com2

    C = np.dot(p2_c[:, :2].T, p1_c[:, :2] * masses[:, np.newaxis])
    U, _, Vt = np.linalg.svd(C)
    R_xy = np.dot(np.dot(U, np.diag([1.0, np.sign(np.linalg.det(np.dot(U, Vt)))])), Vt)
    rot_angle = np.arccos(np.clip(np.trace(R_xy)/2.0, -1.0, 1.0)) * 180.0 / np.pi
    
    p2_aligned = np.copy(p2_c)
    p2_aligned[:, :2] = np.dot(p2_c[:, :2], R_xy)

    in_diff = p2_aligned - p1_c
    d_sq_xy = np.sum(in_diff[:, :2]**2, axis=1)
    d_sq_z = in_diff[:, 2]**2
    
    rmsd_xy = np.sqrt(np.sum(masses * d_sq_xy) / total_mass)
    rmsd_z = np.sqrt(np.sum(masses * d_sq_z) / total_mass)
    d_xy = np.sqrt(d_sq_xy); max_id = np.argmax(d_xy)
    
    e_std_str, e_drift_str, e_tot_str, cut_info = 'NA', 'NA', 'NA', 'None'
    if thermo_file:
        try:
            data = np.loadtxt(thermo_file)
            if data.ndim == 2 and data.shape[1] >= 2:
                start_idx = int(len(data) * 0.30)
                e_arr = data[start_idx:, 1]
                e_tot = e_arr[-1] - e_arr[0]
                e_std = np.std(e_arr) / n_atoms
                e_drift = e_tot / n_atoms
                e_std_str = f'{e_std:.5f}'
                e_drift_str = f'{e_drift:.5f}'
                e_tot_str = f'{e_tot:.3f}'
                cut_info = f'弃前30%升温期, 取后{len(e_arr)}步稳态区'
        except Exception:
            pass

    res = f'SUCCESS|{rmsd_xy:.4f}|{rmsd_z:.4f}|{d_xy[max_id]:.4f}|{atoms1[max_id].symbol}|{max_id+1}|{drift[0]:.3f}|{drift[1]:.3f}|{drift[2]:.3f}|{rot_angle:.2f}|{e_std_str}|{e_drift_str}|{e_tot_str}|{cut_info}|{sys_elems_str}'
    print(res)
except Exception as e:
    print(f'ERROR|{str(e)}')
" "$F1" "$F2" "$THERMO_FILE")

if [[ "$OUTPUT" == ERROR* ]]; then echo -e "${C_RED}运行失败: ${OUTPUT#*|}${C_RESET}" && exit 1; fi
IFS='|' read -r status R_XY R_Z M_DISP M_ATOM M_ID D_X D_Y D_Z ROT_ANG E_STD E_DRIFT E_TOT CUT_INFO SYS_ELEMS <<< "$OUTPUT"

# --- 输出报告 ---
echo "=========================================================="
echo -e "\033[1;37m2D 材料 MD 稳定性评估 (能量热力学主导版)\033[0m"
echo -e "识别体系: ${C_BLUE}[ $SYS_ELEMS ]${C_RESET} | 文件: [$F1 vs $F2]"
echo "=========================================================="
echo -e "\033[1;37m[1. 已排除的刚体假象]\033[0m"
echo -e "  体系平移: X=$D_X, Y=$D_Y, Z=$D_Z (Å)"
echo -e "  面内旋转: ${C_BLUE}$ROT_ANG °${C_RESET}"
echo ""
echo -e "\033[1;37m[2. 真实结构形变 (动态质量加权)]\033[0m"
echo -e "  面内整体变形(RMSD) : $(format_color "$R_XY" "$WARN_RMSD_XY" "$DANGER_RMSD_XY") Å"
echo -e "  面外褶皱起伏(RMSD) : $(format_color "$R_Z" "$WARN_RMSD_Z" "$DANGER_RMSD_Z") Å"
echo -e "  [辅] 最大脱离位移  : $(format_color "$M_DISP" "$WARN_MAX_DISP" "$DANGER_MAX_DISP") Å ($M_ATOM #$M_ID)"
echo ""
echo -e "\033[1;37m[3. 热力学演化诊断 (${THERMO_FILE:-无日志})]\033[0m"
if [ "$E_STD" != "NA" ]; then
    echo -e "  处理策略: ${C_BLUE}$CUT_INFO${C_RESET}"
    echo -e "  稳态能量漂移(趋势): $(format_e_drift "$E_DRIFT" "$DANGER_E_SPIKE") eV/atom"
    echo -e "  稳态能量起伏(振荡): $(format_color "$E_STD" "$WARN_E_STD" "$DANGER_E_STD") eV/atom"
    echo -e "  稳态总能量净变化  : $E_TOT eV"
else
    echo -e "  未探测到日志文件，降级使用纯结构判定。"
fi
echo "=========================================================="

# --- 判定系统 (【修改点】：完全移除 M_DISP 对报错的影响) ---
is_distort=$(awk -v r="$R_XY" -v t="$DANGER_RMSD_XY" 'BEGIN {print (r > t) ? 1 : 0}')
is_e_spike=$(awk -v d="$E_DRIFT" -v dt="$DANGER_E_SPIKE" 'BEGIN {print (d > dt) ? 1 : 0}')
is_e_std=$(awk -v s="$E_STD" -v t="$DANGER_E_STD" 'BEGIN {print (s > t) ? 1 : 0}')

# 能量具有绝对一票否决权
if [ "$is_e_spike" -eq 1 ]; then
    echo -e "结论: ${C_RED}[致命破坏] 能量暴涨！系统发生强吸热断键或严重的相变解体。${C_RESET}"
elif [ "$is_e_std" -eq 1 ]; then
    echo -e "结论: ${C_YELLOW}[临界警告] 稳定期能量剧烈震荡！结构可能处于熔融边缘。${C_RESET}"
elif [ "$is_distort" -eq 1 ]; then
    echo -e "结论: ${C_YELLOW}[晶格畸变] 能量稳定，但整体晶格发生了显著面内拉伸变形 (RMSD过大)。${C_RESET}"
else
    # 只要能量平稳，RMSD达标，就是极度稳定（无视了个别原子的乱跑）
    is_e_relax=$(awk -v d="$E_DRIFT" 'BEGIN {print (d < -0.01) ? 1 : 0}')
    is_rippled=$(awk -v r="$R_Z" -v t="$WARN_RMSD_Z" 'BEGIN {print (r > t) ? 1 : 0}')
    
    if [ "$is_e_relax" -eq 1 ]; then
        if [ "$is_rippled" -eq 1 ]; then
            echo -e "结论: ${C_GREEN}[极其完美] 发生正常二维热起伏，且体系能量成功下降弛豫至极小值！${C_RESET}"
        else
            echo -e "结论: ${C_GREEN}[极度稳定] 骨架整体完好，能量在生产区继续平稳下降优化！${C_RESET}"
        fi
    else
        echo -e "结论: ${C_GREEN}[完美平衡] 热力学数据完全收敛，体系处于极度稳定的健康状态！${C_RESET}"
    fi
fi
echo "=========================================================="

