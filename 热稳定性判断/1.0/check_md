#!/bin/bash

# ==============================================================================
# 脚本名称: check_md.sh
# 功能: 自动比对任意两个结构文件，评估 MD 模拟的结构稳定性 (RMSD)
# 依赖: python3, ase (pip install ase)
# ==============================================================================

# 定义颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# 1. 环境检查
python3 -c "import ase" 2>/dev/null
if [ $? -ne 0 ]; then
    echo -e "${RED}Error: 需要安装 python ase 库。${NC}"
    echo -e "请运行: ${YELLOW}pip install ase numpy${NC}"
    exit 1
fi

echo -e "${CYAN}=== MD 结构稳定性分析工具 ===${NC}"

# 2. 扫描文件 (排除脚本自身和隐藏文件)
FILES=($(ls -p | grep -v / | grep -v ".sh$" | grep -v "^\."))
NUM_FILES=${#FILES[@]}

FILE_1=""
FILE_2=""

# 3. 智能文件选择逻辑
if [ "$NUM_FILES" -lt 2 ]; then
    echo -e "${RED}错误: 当前目录下文件不足 2 个，无法比对。${NC}"
    exit 1
elif [ "$NUM_FILES" -eq 2 ]; then
    FILE_1=${FILES[0]}
    FILE_2=${FILES[1]}
    echo -e "检测到两个文件，自动选中:"
    echo -e "  结构 A: ${YELLOW}$FILE_1${NC}"
    echo -e "  结构 B: ${YELLOW}$FILE_2${NC}"
else
    echo -e "${YELLOW}当前目录有多个文件，请选择用于比对的两个文件:${NC}"
    for i in "${!FILES[@]}"; do 
        echo "  [$i] ${FILES[$i]}"
    done
    echo ""
    read -p "请输入结构 A 的编号: " idx1
    read -p "请输入结构 B 的编号: " idx2
    
    if [[ -z "${FILES[$idx1]}" ]] || [[ -z "${FILES[$idx2]}" ]]; then
        echo -e "${RED}错误: 编号无效。${NC}"
        exit 1
    fi
    FILE_1=${FILES[$idx1]}
    FILE_2=${FILES[$idx2]}
fi

echo "----------------------------------------------------"
echo "正在计算 RMSD (自动处理周期性边界)..."

# 4. Python 计算核心
# 使用 python3 -c 配合 here-document 执行
python3 -c "
import sys
import warnings
import numpy as np
from ase.io import read

# === 屏蔽 ASE 的无关警告 (如 cif 空间群警告) ===
warnings.filterwarnings('ignore')

try:
    f1 = '$FILE_1'
    f2 = '$FILE_2'

    # 读取结构
    try:
        atoms1 = read(f1)
        atoms2 = read(f2)
    except Exception as e:
        print(f'READ_ERROR:{e}')
        sys.exit(0)

    # 检查原子数
    if len(atoms1) != len(atoms2):
        print(f'COUNT_MISMATCH:{len(atoms1)} vs {len(atoms2)}')
        sys.exit(0)

    # 检查化学式 (作为一种保险措施)
    if atoms1.get_chemical_formula() != atoms2.get_chemical_formula():
        print('FORMULA_WARNING')

    # 获取坐标和晶胞
    pos1 = atoms1.get_positions()
    pos2 = atoms2.get_positions()
    cell = atoms1.get_cell()
    pbc = atoms1.get_pbc()

    # 计算位移向量
    diff = pos2 - pos1

    # === 核心：最小镜像约定 (Minimum Image Convention) ===
    # 用于处理 MD 中原子跨越盒子边界的情况
    if any(pbc):
        # 转换为分数坐标
        # 如果 cell 为 0 (非周期性)，跳过
        if np.linalg.det(cell) > 1e-8:
            scaled_diff = np.linalg.solve(cell.T, diff.T).T
            # 将位移限制在 -0.5 到 0.5 之间
            scaled_diff -= np.round(scaled_diff)
            # 转回笛卡尔坐标
            diff = np.dot(scaled_diff, cell)

    # 计算距离
    dists = np.linalg.norm(diff, axis=1)
    
    # 统计数据
    rmsd = np.sqrt(np.mean(dists**2))
    max_disp = np.max(dists)
    max_idx = np.argmax(dists)
    max_atom = atoms1[max_idx].symbol

    # 打印结果给 Shell
    print(f'RESULT|{rmsd:.5f}|{max_disp:.5f}|{max_atom}|{max_idx+1}')

except Exception as e:
    print(f'PYTHON_ERROR:{e}')
" > .md_check_tmp

# 5. 解析 Python 输出
OUTPUT=$(cat .md_check_tmp)
rm -f .md_check_tmp

# 错误处理
if [[ "$OUTPUT" == READ_ERROR* ]]; then
    echo -e "${RED}读取文件失败，格式可能不支持或文件损坏。${NC}"
    echo "详情: ${OUTPUT#*:}"
    exit 1
elif [[ "$OUTPUT" == COUNT_MISMATCH* ]]; then
    echo -e "${RED}错误: 两个文件的原子数量不一致，无法计算 RMSD。${NC}"
    echo "详情: ${OUTPUT#*:}"
    exit 1
elif [[ "$OUTPUT" == PYTHON_ERROR* ]]; then
    echo -e "${RED}脚本运行出错。${NC}"
    echo "详情: ${OUTPUT#*:}"
    exit 1
fi

if [[ "$OUTPUT" == *"FORMULA_WARNING"* ]]; then
    echo -e "${YELLOW}警告: 两个结构的元素种类或顺序似乎不一致，结果可能无意义。${NC}"
fi

# 提取数据
# 格式 RESULT|RMSD|MAX_DISP|ATOM_SYMBOL|ATOM_ID
DATA_LINE=$(echo "$OUTPUT" | grep "RESULT")
RMSD=$(echo "$DATA_LINE" | cut -d'|' -f2)
MAX_DISP=$(echo "$DATA_LINE" | cut -d'|' -f3)
ATOM_SYM=$(echo "$DATA_LINE" | cut -d'|' -f4)
ATOM_ID=$(echo "$DATA_LINE" | cut -d'|' -f5)

# 6. 结果判定与输出
echo -e "分析结果:"
echo -e "  - RMSD (结构整体偏差):   ${CYAN}$RMSD Å${NC}"
echo -e "  - 最大原子位移:          ${CYAN}$MAX_DISP Å${NC} (原子: $ATOM_SYM #$ATOM_ID)"

echo "----------------------------------------------------"
# MD 稳定性判定标准 (经验值)
# 小于 1.0 Å: 通常仅为热振动，结构保持完好
# 1.0 - 2.0 Å: 结构有变形，但在高温MD中可能属于正常波动
# 大于 2.0 Å: 结构可能发生了重构、键断裂或扩散

LIMIT_STABLE=1.0
LIMIT_WARN=2.0

if (( $(echo "$RMSD < $LIMIT_STABLE" | bc -l) )); then
    echo -e "${GREEN}[判定]: 结构非常稳定 (Stable)${NC}"
    echo "RMSD 很小，结构基本保持原状，仅有微小热振动。"
elif (( $(echo "$RMSD > $LIMIT_WARN" | bc -l) )); then
    echo -e "${RED}[判定]: 结构发生显著变化/不稳定 (Unstable/Reconstructed)${NC}"
    echo "RMSD 较大，可能发生了键断裂、相变或原子扩散。"
else
    echo -e "${YELLOW}[判定]: 结构存在明显变形 (Meta-Stable/Distorted)${NC}"
    echo "处于临界区间，请使用可视化软件 (OVITO/VESTA) 确认结构细节。"
fi
echo "----------------------------------------------------"

