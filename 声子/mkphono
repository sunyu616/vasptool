#!/bin/bash

# 1. 提示用户输入数字
read -p "请输入3位数字 (例如 161): " num

# 检查输入是否为空
if [ -z "$num" ]; then
    echo "错误：输入不能为空！退出脚本。"
    exit 1
fi

# 生成主文件夹名称
dir_name="phonopy${num}"

# 2. 创建并进入目标文件夹
echo "=> [1/5] 正在创建文件夹: ${dir_name}"
mkdir -p "${dir_name}"

echo "=> [2/5] 正在拷贝初始文件 (CONTCAR KPOINTS INCAR POTCAR wk.pbs)..."
cp CONTCAR KPOINTS INCAR POTCAR wk.pbs "${dir_name}/" || { 
    echo "错误：部分文件拷贝失败！请确保当前目录下有这些文件。"
    exit 1
}

# 切换到工作目录
cd "${dir_name}" || exit 1

# 3. 准备 VASP 文件 (CONTCAR -> POSCAR, 修改 INCAR)
if [ -f "CONTCAR" ]; then
    mv CONTCAR POSCAR
else
    echo "警告：未找到 CONTCAR 文件！"
fi

if [ -f "INCAR" ]; then
    echo "=> [3/5] 正在修改 INCAR 参数 (IBRION = -1, NSW = 0)..."
    
    # 替换或追加 IBRION
    if grep -q "^[[:space:]]*IBRION" INCAR; then
        sed -i 's/^[[:space:]]*IBRION.*/IBRION = -1/g' INCAR
    else
        echo "IBRION = -1" >> INCAR
    fi

    # 替换或追加 NSW
    if grep -q "^[[:space:]]*NSW" INCAR; then
        sed -i 's/^[[:space:]]*NSW.*/NSW = 0/g' INCAR
    else
        echo "NSW = 0" >> INCAR
    fi
else
    echo "警告：未找到 INCAR 文件！"
fi

# 4. 拆分数字并运行 phonopy
dim1=${num:0:1}
dim2=${num:1:1}
dim3=${num:2:1}
dim_str="${dim1} ${dim2} ${dim3}"

echo "=> [4/5] 正在运行: phonopy -d --dim=\"${dim_str}\""
phonopy -d --dim="${dim_str}"

# 5. 自动检测 phonopy 生成的 POSCAR，并创建两位数命名的子文件夹
echo "=> [5/5] 正在自动检测位移生成的 POSCAR 文件并构建目录..."

# 查找所有格式为 POSCAR-开头的数字文件
poscar_files=$(ls POSCAR-[0-9]* 2>/dev/null)

if [ -z "$poscar_files" ]; then
    echo "错误：未检测到 phonopy 生成任何 POSCAR-* 文件。请检查 phonopy 是否运行成功。"
    exit 1
fi

count=$(echo "$poscar_files" | wc -w)
echo "=> 检测到 $count 个产生的位移结构，开始分配文件夹..."

# 遍历每一个生成的 POSCAR 文件
for file in $poscar_files; do
    # 提取数字后缀 (如从 POSCAR-001 中提取出 001)
    raw_suffix="${file#POSCAR-}"
    
    # 将提取的字符串强制作为10进制解析（防止bash把008当作错误的八进制数报错）
    num_int=$((10#$raw_suffix))
    
    # 将数字格式化为两位数 (01, 02, ..., 11, 12)
    folder_name=$(printf "%02d" $num_int)
    
    # 创建以两位数字命名的子文件夹
    mkdir -p "$folder_name"
    
    # 将当前的 POSCAR-xxx 移动到对应子文件夹并重命名为 POSCAR
    mv "$file" "$folder_name/POSCAR"
    
    # 将算力脚本和修改后的 VASP 文件复制进子文件夹
    cp INCAR KPOINTS POTCAR wk.pbs "$folder_name/"
done

echo "=> 任务完成！已成功创建 $count 个两位数命名的文件夹并配置完毕。"

