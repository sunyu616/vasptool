#!/bin/bash

# =======================================================
# 脚本功能：删除除了 INCAR, KPOINTS, wk.pbs 以外的所有文件和文件夹
# 注意事项：操作不可逆，请确保重要文件/文件夹已备份
# =======================================================

# 严格模式：遇到错误立即退出，未定义变量直接报错
set -euo pipefail

# 获取当前脚本的文件名，防止删除自身
SCRIPT_NAME=$(basename "$0")

# 确保使用 bash 执行，且开启扩展通配符（兼容不同 bash 版本）
if [[ -z "$BASH_VERSION" ]]; then
    echo "错误：请使用 bash 执行本脚本（而非 sh）"
    exit 1
fi
shopt -s extglob 2>/dev/null || { echo "警告：无法开启 extglob，脚本可能执行失败"; exit 1; }

# ===================== 新增确认逻辑 =====================
# 1. 列出即将被删除的内容（预览）
echo -e "\033[33m警告：以下内容将被永久删除（包括文件和文件夹）：\033[0m"
# 先检查是否有要删除的内容，避免空输出
if ls -l !($SCRIPT_NAME|INCAR|KPOINTS|wk.pbs) 2>/dev/null; then
    echo -e "\n\033[31m注意：删除操作不可逆，请谨慎确认！\033[0m"
else
    echo -e "\033[32m当前目录下无需要删除的内容。\033[0m"
    exit 0
fi

# 2. 交互式确认
read -p $'\n是否确认删除以上内容？(输入 y/Y 确认，其他任意键取消)：' CONFIRM
if [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" ]]; then
    echo -e "\033[32m操作已取消，未删除任何内容。\033[0m"
    exit 0
fi
# =======================================================

# 执行删除操作（同时删除文件和文件夹）
echo -e "\n开始清理..."
rm -rf !($SCRIPT_NAME|INCAR|KPOINTS|wk.pbs)

echo -e "\033[32m清理完成。仅保留了 INCAR, KPOINTS, wk.pbs 以及本脚本：$SCRIPT_NAME。\033[0m"
