# ==============================================================================
# 2. 辅助函数定义
# ==============================================================================
def modify_incar(incar_path, modifications):
    if not os.path.exists(incar_path): 
        c_log(f"Warning: INCAR 丢失 ({incar_path})!", "WARN")
        return
    with open(incar_path, 'r') as f: lines = f.readlines()
    new_lines = []
    updated_keys = {k: False for k in modifications.keys()}
    for line in lines:
        stripped = line.strip()
        if '=' in stripped and not stripped.startswith('#') and not stripped.startswith('!'):
            key = stripped.split('=')[0].strip().upper()
            if key in modifications:
                new_lines.append(f" {key} = {modifications[key]}\n")
                updated_keys[key] = True
                continue
        new_lines.append(line)
    for key, val in modifications.items():
        if not updated_keys[key]: new_lines.append(f" {key} = {val}\n")
    with open(incar_path, 'w') as f: f.writelines(new_lines)
    # 取消了细碎的修改日志输出，以保持主界面整洁

def extract_nbands(outcar_path):
    with open(outcar_path, 'r') as f:
        for line in f:
            if 'NBANDS' in line:
                match = re.search(r'NBANDS\s*=\s*(\d+)', line)
                if match:
                    nbands = int(match.group(1))
                    return nbands
    raise ValueError("无法在 OUTCAR 中找到 NBANDS！")

def write_and_chmod(filepath, content):
    with open(filepath, 'w') as f: f.write(content.strip() + "\n")
    st = os.stat(filepath)
    os.chmod(filepath, st.st_mode | stat.S_IEXEC)

def run_vaspkit(task_id, cwd):
    # 将 vaspkit 的输出完全静默，避免终端和日志杂乱
    subprocess.run(["vaspkit"], input=f"{task_id}\n", text=True, cwd=cwd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# ==============================================================================
# 3. 主工作流
# ==============================================================================
def main():
    root_dir = os.getcwd()
    scf_dir = os.path.join(root_dir, "scf")
    banddos_dir = os.path.join(scf_dir, "band+dos")

    # ------------------ 初始化 ------------------
    open("workflow.log", "w").close() 
    c_log("=== VASP FULL AUTOMATION WORKFLOW STARTED ===", "ITER")

    # --- 第一阶段：SCF ---
    c_log("", "INFO")
    c_log(">>> 第一阶段：SCF 静态自洽计算 <<<", "ITER")
    os.makedirs(scf_dir, exist_ok=True)
    
    for f in ["CONTCAR", "INCAR", "KPOINTS", "POTCAR", "wk.pbs"]:
        src = os.path.join(root_dir, f)
        if os.path.exists(src): shutil.copy(src, scf_dir)
        else:
            c_log(f"错误: 根目录下缺少关键输入文件 {f}", "ERROR")
            return
            
    os.rename(os.path.join(scf_dir, "CONTCAR"), os.path.join(scf_dir, "POSCAR"))
    modify_incar(os.path.join(scf_dir, "INCAR"), {"NSW": "0", "IBRION": "-1", "LCHARG": "T"})
    write_and_chmod(os.path.join(scf_dir, "vasp_infinite_wait.py"), VASP_INFINITE_WAIT_SCRIPT)
    
    c_log("正在后台运行 SCF 任务，请耐心等待...", "INFO")
    with open(os.path.join(scf_dir, "stdout.log"), "w") as out_log:
        subprocess.run(["python3", "-u", "vasp_infinite_wait.py"], cwd=scf_dir, stdout=out_log, stderr=subprocess.STDOUT)
    c_log("SCF 任务已完成！", "SUCCESS")

    old_nbands = extract_nbands(os.path.join(scf_dir, "OUTCAR"))
    new_nbands = old_nbands + 60
    c_log(f"解析 OUTCAR：提取 NBANDS = {old_nbands}，扩展目标 NBANDS = {new_nbands}", "DATA")

    # --- 第二阶段：BAND + DOS ---
    c_log("", "INFO")
    c_log(">>> 第二阶段：BAND + DOS 联合计算 <<<", "ITER")
    os.makedirs(banddos_dir, exist_ok=True)

    for f in ["CONTCAR", "POTCAR", "INCAR", "KPOINTS", "CHGCAR", "wk.pbs"]:
        src = os.path.join(scf_dir, f)
        if os.path.exists(src): shutil.copy(src, banddos_dir)
        else:
            c_log(f"错误: SCF 目录未找到 {f}，前置计算可能已崩塌。", "ERROR")
            return

    os.rename(os.path.join(banddos_dir, "CONTCAR"), os.path.join(banddos_dir, "POSCAR"))
    
    c_log("正在调用 Vaspkit 生成 KPATH...", "INFO")
    run_vaspkit("302", banddos_dir)
    kpath_file = os.path.join(banddos_dir, "KPATH.in")
    if os.path.exists(kpath_file): shutil.copy(kpath_file, os.path.join(banddos_dir, "KPOINTS"))
    else:
        c_log("错误: vaspkit 302 未能生成 KPATH.in", "ERROR")
        return

    modify_incar(os.path.join(banddos_dir, "INCAR"), {
        "ICHARG": "11", "LCHARG": "F", "NEDOS": "601",
        "EMAX": "8", "EMIN": "-8", "NBANDS": str(new_nbands)
    })

    write_and_chmod(os.path.join(banddos_dir, "vasp_infinite_wait.py"), VASP_INFINITE_WAIT_SCRIPT)
    
    c_log("正在后台运行 BAND+DOS 任务，请耐心等待...", "INFO")
    with open(os.path.join(banddos_dir, "stdout.log"), "w") as out_log:
        subprocess.run(["python3", "-u", "vasp_infinite_wait.py"], cwd=banddos_dir, stdout=out_log, stderr=subprocess.STDOUT)
    c_log("BAND+DOS 任务已完成！", "SUCCESS")

    # --- 第三阶段：数据处理 ---
    c_log("", "INFO")
    c_log(">>> 第三阶段：数据提取与自动绘图 <<<", "ITER")
    
    write_and_chmod(os.path.join(banddos_dir, "doscal"), DOSCAL_SCRIPT)
    write_and_chmod(os.path.join(banddos_dir, "bandcal"), BANDCAL_SCRIPT)

    c_log("提取 DOS 矩阵并绘制 PDOS...", "INFO")
    run_vaspkit("116", banddos_dir)
    subprocess.run(["./doscal"], cwd=banddos_dir, stdout=subprocess.DEVNULL)

    c_log("提取能带本征值并绘制 Band Structure...", "INFO")
    run_vaspkit("211", banddos_dir)
    subprocess.run(["./bandcal"], cwd=banddos_dir, stdout=subprocess.DEVNULL)
    c_log("图像渲染结束！", "SUCCESS")

    # --- 第四阶段：整理出图文件 ---
    c_log("", "INFO")
    c_log(">>> 第四阶段：成果打包归档 <<<", "ITER")
    png_dat_dir = os.path.join(banddos_dir, "png_dat")
    os.makedirs(png_dat_dir, exist_ok=True)

    files_to_move = ["band_structure.png", "PDOS_final_v4.png", "BAND.dat"]
    pdos_pattern = os.path.join(banddos_dir, "PDOS_*.dat")
    for f in glob.glob(pdos_pattern): files_to_move.append(os.path.basename(f))

    moved_count = 0
    for file_name in set(files_to_move):
        src = os.path.join(banddos_dir, file_name)
        dst = os.path.join(png_dat_dir, file_name)
        if os.path.exists(src):
            shutil.move(src, dst)
            moved_count += 1

    c_log(f"已将 {moved_count} 个结果文件安全归档至 png_dat/ 文件夹。", "SUCCESS")

    c_log("", "INFO")
    c_log("=== 全部自动化任务圆满结束 ===", "SUCCESS")

if __name__ == "__main__":
    main()
